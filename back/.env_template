# ============================================================
# CRMIA - Backend - Plantilla de variables de entorno
# Copia este fichero a `.env` y rellena los valores reales.
# NUNCA se versionan claves reales: `.env` esta en .gitignore.
# ============================================================

# --- Servidor ---
PORT=3000
URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- JWT ---
JWTSECRET=cambia-esta-clave-en-produccion
JWTEXPIREIN=24h

# --- Usuario administrador semilla (se crea en el primer arranque) ---
# Email fijo: admin@crmia.local
ADMIN_PASSWORD=admin1234

# --- Logs ---
ERRORLOGS=false
WEBHOOK_URL=
ENABLE_WEBHOOK_LOGS=false

# --- Base de datos ---
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=crmia
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Almacenamiento de ficheros ---
UPLOADS_DIR=./uploads

# --- IA (NVIDIA, endpoint compatible con OpenAI) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Espera maxima por intento (ms). Con 1 reintento, el peor caso son ~50 s.
NVIDIA_TIMEOUT_MS=25000

# --- Transcripcion de voz (ElevenLabs) ---
ELEVENLABS_API_KEY=

# --- Edicion de documentos (ONLYOFFICE) ---
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=

# --- Conversion a PDF (Gotenberg) ---
GOTENBERG_URL=http://localhost:3001
