# ---------------------------------------------------------------------------
# CRMIA - plantilla de variables de entorno
# Copia este fichero a .env y rellena los valores reales:
#     cp .env.template .env
# El fichero .env esta en .gitignore: NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
URL=http://localhost:3000

# --- Base de datos (PostgreSQL, contenedor crmia_postgres) ------------------
# DB_PORT es tambien el puerto que docker compose publica en el host:
# si 5437 ya esta ocupado por otro proyecto, cambialo aqui y todo se ajusta.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5437
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=crmia
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Autenticacion ----------------------------------------------------------
# Genera un secreto propio:  openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=24h

# Contrasena del administrador semilla admin@crmia.local, creado en el primer
# arranque. Solo se aplica a la creacion inicial: una vez existe el usuario,
# cambiarla aqui no cambia la del usuario ya guardado.
ADMIN_PASSWORD=admin1234

# --- IA: DOS proveedores compatibles con OpenAI, en cadena ------------------
# El asistente pregunta al PRIMARIO y, si no responde, repite la misma peticion
# contra el RESPALDO. "No responde" incluye: agotar el tiempo de espera, error
# de red, HTTP >= 400 y contestar sin contenido utilizable.
#
# Los nombres antiguos NVIDIA_API_KEY / NVIDIA_BASE_URL / NVIDIA_MODEL /
# NVIDIA_TIMEOUT_MS siguen valiendo como alias del PRIMARIO, asi que un .env ya
# desplegado no necesita tocarse.
#
# --- Primario ---
# Cloudflare Workers AI. La URL lleva dentro el id de cuenta:
#   https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# La clave es un API token de Cloudflare con permiso de Workers AI.
LLM_API_KEY=
LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/CAMBIA_ESTE_ACCOUNT_ID/ai/v1
# Medido el 25/08/2026 desde el servidor, orden completa (dos llamadas al
# modelo) con las herramientas del asistente:
#   @cf/meta/llama-4-scout-17b-16e-instruct .. p50 982 ms, 6/6 herramientas
LLM_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Espera maxima por intento contra el PRIMARIO. Corta a proposito: si Cloudflare
# responde en ~1 s y tarda mas de 8, no va lento, es que no va, y lo que salva
# la orden es saltar ya al respaldo.
LLM_TIMEOUT_MS=8000
#
# --- Respaldo (opcional) ---
# Vacias = mismo proveedor que el primario con otro modelo (comportamiento
# anterior a la cadena de dos proveedores). Aqui se configura NVIDIA entero,
# para que una caida de Cloudflare no deje al CRM sin asistente.
#   openai/gpt-oss-120b .. p50 2,0 s, 0 errores en 36 ordenes (25/08/2026)
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# El respaldo puede permitirse mas espera que el primario, pero tampoco mucha
# mas. Medido el 26/08/2026 desde el servidor, NVIDIA en el tier gratuito
# resulta BIMODAL: o contesta en 1,4-1,8 s o se va a 68-90 s, sin termino
# medio. Con esa forma, subir el limite por encima de 15 s no rescata ni una
# orden mas -no hay respuestas entre 15 y 60 s- y en cambio alarga la espera
# del peor caso. 15 s captura el modo rapido entero y abandona el lento.
LLM_FALLBACK_TIMEOUT_MS=15000

# --- Transcripcion de audio: ElevenLabs -------------------------------------
ELEVENLABS_API_KEY=

# --- ONLYOFFICE Document Server (edicion de documentos) ---------------------
# El mismo secreto debe estar en el contenedor y en el backend.
ONLYOFFICE_JWT_SECRET=cambia-este-secreto-en-produccion
#
# TRES URLS, TRES PUNTOS DE VISTA. Es donde mas se falla en esta integracion:
#
# 1. ONLYOFFICE_URL -> como ve el BACKEND al Document Server.
#    En desarrollo (back en el host) es localhost:8081. En produccion
#    docker-compose.prod.yml lo fija a `http://onlyoffice`, el nombre del
#    servicio en la red de compose, y el valor de este fichero solo actua de
#    respaldo de la URL publica.
ONLYOFFICE_URL=http://localhost:8081
#
# 2. ONLYOFFICE_PUBLIC_URL -> como ve el NAVEGADOR al Document Server.
#    Es la que el backend devuelve en `scriptUrl`, asi que TIENE que ser
#    alcanzable desde fuera de Docker. En produccion es el dominio publico del
#    Document Server (p.ej. https://crmia-office.midominio.tld); poner aqui la
#    interna deja al editor en "No se pudo contactar con el servidor de
#    edicion". Vacia = se usa ONLYOFFICE_URL (correcto en desarrollo).
ONLYOFFICE_PUBLIC_URL=http://localhost:8081
#
# 3. ONLYOFFICE_INTERNAL_API_URL -> como ve el CONTENEDOR de ONLYOFFICE a la API
#    del CRM. De ahi salen `document.url` y `callbackUrl`. Dejala vacia salvo
#    problemas: se deriva de URL reescribiendo `localhost` a
#    `host.docker.internal` (que resuelve gracias al `extra_hosts` de
#    docker-compose.dev.yml). En produccion se usa el dominio publico, que
#    funciona si el proxy inverso admite hairpin desde el propio host; si no,
#    ponla a `http://caddy`.
ONLYOFFICE_INTERNAL_API_URL=

# --- Gotenberg (conversion a PDF) -------------------------------------------
GOTENBERG_URL=http://localhost:3001

# --- Almacenamiento ---------------------------------------------------------
UPLOADS_DIR=./uploads

# --- Front (Vite) -----------------------------------------------------------
# Vite lee su propio front/.env; se declara aqui como referencia unica.
VITE_API_URL=http://localhost:3000/api

# --- Despliegue (solo docker-compose.prod.yml) ------------------------------
# ":80" en local; el dominio real en el servidor para HTTPS automatico.
CADDY_SITE_ADDRESS=:80
CADDY_EMAIL=admin@example.com

# URL publica desde la que se sirve la app. Alimenta los enlaces de firma que
# genera el backend, asi que tiene que ser la que abre el navegador del cliente.
FRONTEND_URL=http://localhost

# Puertos que docker compose publica en el host. El formato es el de la clave
# `ports` de compose, asi que admite tambien la interfaz:
# "127.0.0.1:8088:80" ata el servicio a loopback y deja que un proxy inverso
# ya instalado en el servidor (Caddy, nginx) sea quien de la cara en 80/443.
CADDY_HTTP_PUBLISH=80:80
CADDY_HTTPS_PUBLISH=443:443
CADDY_HTTPS_UDP_PUBLISH=443:443/udp
ONLYOFFICE_PUBLISH=8081:80
