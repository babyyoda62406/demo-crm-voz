# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
dist-ssr/
**/dist/
**/build/
**/dist-ssr/

# Environment variables
.env
.env.*
!.env.template
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Ficheros subidos por la aplicacion
# (se ignora el contenido, no la carpeta: asi el .gitkeep mantiene la ruta)
uploads/*
**/uploads/*
!**/uploads/.gitkeep

# Documentos generados (PDF de presupuestos, exportaciones...)
generated/
**/generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# IDE and editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/
**/coverage/
**/.nyc_output/

# Temporary files
.temp/
.tmp/
temp/
tmp/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# TypeScript
*.tsbuildinfo
**/*.tsbuildinfo

# Cache
.cache/
**/.cache/

# Docker / Caddy (datos locales de volumenes bind)
deploy/caddy_data/
deploy/caddy_config/

# Standalone builds (NestJS)
standalone/
**/standalone/
